# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4100

# PostgreSQL connection string — a genuinely SEPARATE database/instance
# from product/api's, per PRODUCT_SPEC.md §2's "Provider Database
# (Platform DB - Separate)" architecture. Not just a different schema on
# the same server: a different Postgres server entirely.
DATABASE_URL="postgresql://user:password@localhost:5432/provider_dev?schema=public"

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
COOKIE_SECRET=""

ACCESS_TOKEN_TTL_MINUTES=20
REFRESH_TOKEN_TTL_DAYS=7

# The provider admin dashboard's own origin (for CORS)
PROVIDER_WEB_ORIGIN="http://localhost:3100"

# RS256 keypair for signing/verifying License JWTs (spec §2 "License Signing
# & Key Management"). Base64-encoded PEM so a multi-line key survives as one
# .env line. Generate with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('rsa',{modulusLength:2048,publicKeyEncoding:{type:'spki',format:'pem'},privateKeyEncoding:{type:'pkcs8',format:'pem'}});console.log('PRIV='+Buffer.from(privateKey).toString('base64'));console.log('PUB='+Buffer.from(publicKey).toString('base64'))"
# The PRIVATE key lives ONLY here, on the provider platform — never shipped
# to a customer deployment. The PUBLIC key is also copied into product/api's
# .env (LICENSE_PUBLIC_KEY_B64) so it can verify a License JWT completely
# offline, per spec's "NO provider API call required" validation rule.
LICENSE_PRIVATE_KEY_B64=""
LICENSE_PUBLIC_KEY_B64=""

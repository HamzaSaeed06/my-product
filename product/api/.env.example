# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL="postgresql://user:password@localhost:5432/product_dev?schema=public"

# Auth secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
COOKIE_SECRET=""

# Access token lifetime in minutes (spec: 15-30)
ACCESS_TOKEN_TTL_MINUTES=20
# Refresh token / session lifetime in days (spec: 7)
REFRESH_TOKEN_TTL_DAYS=7

# CORS — the web app origin
WEB_APP_ORIGIN="http://localhost:3000"

# Local disk storage for uploaded documents (spec §8 file upload security)
DOCUMENT_STORAGE_DIR="storage/documents"
MAX_UPLOAD_SIZE_MB=10

# Phase 10 (Provider Platform) — both optional. Leave unset for a local/dev
# instance that hasn't been issued a license yet; it runs fully unrestricted
# (see src/lib/license.ts). To license this deployment: generate a Customer
# + Plan + Deployment + License on provider/api, then paste the returned
# signedJwt here and copy provider/api's LICENSE_PUBLIC_KEY_B64 verbatim.
LICENSE_JWT=""
LICENSE_PUBLIC_KEY_B64=""

# Where this deployment sends its daily heartbeat (see
# src/lib/heartbeatSender.ts) and the token issued for it at Deployment
# creation on provider/api. Optional for the same "not yet licensed" reason.
PROVIDER_API_URL="http://localhost:4100"
DEPLOYMENT_HEARTBEAT_TOKEN=""

// Phase 0 — Foundation models only.
// See docs/PRODUCT_SPEC.md → "PHASE 0: FOUNDATION" and "MODEL OWNERSHIP TABLE".
//
// DEVIATION FROM SPEC (recorded per docs/README.md convention):
// PRODUCT_SPEC.md's Model Ownership Table lists 10 Phase 0 models but never
// explicitly lists a `User` model, even though UserRole, Session, AuditLog,
// ApprovalRequest, Document, and Notification all reference a user. This is
// clearly required and implied — Phase 0 cannot ship login without it — so
// `User` is added here as an 11th Phase 0 model. Logged in
// docs/PROJECT_STATUS.md.
//
// Campus/Institute scoping (e.g. on UserRole) is deferred to Phase 1 per the
// spec's own InchargeScope migration precedent — Phase 1 owns Campus,
// AcademicYear, Class, Section. UserRole.campusId is a plain string for now
// (no FK) and will gain a real relation when Campus lands in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Migrations run through this connection instead of DATABASE_URL, per
  // Prisma's own recommended fix for a real bug found while building the
  // onboard-customer.ts bootstrap script: `prisma migrate deploy` against
  // a PgBouncer-pooled connection (Neon's "-pooler" endpoint, and most
  // managed Postgres poolers generally) can leak its migration advisory
  // lock onto a pooled backend connection that outlives the migrate
  // command — a later, unrelated query reusing that same pooled backend
  // then silently inherits the held lock, and the next real migrate
  // deploy times out acquiring it ("P1002 ... Timed out trying to
  // acquire a postgres advisory lock"), reproduced twice in a row against
  // this exact database. DIRECT_DATABASE_URL should point at the same
  // database via a non-pooled connection; for a customer whose Postgres
  // has no pooled/direct distinction (self-hosted, a single connection
  // string), set it to the same value as DATABASE_URL.
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// Identity
// ─────────────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  fullName     String
  isActive     Boolean  @default(true)
  mfaEnabled   Boolean  @default(false)
  mfaSecret    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userRoles                 UserRole[]
  sessions                  Session[]
  notifications             Notification[]
  notificationPreference    NotificationPreference?
  documentsUploaded         Document[]              @relation("DocumentUploadedBy")
  auditLogsAsActor          AuditLog[]              @relation("AuditActor")
  approvalRequestsRequested ApprovalRequest[]       @relation("ApprovalRequestedBy")
  approvalRequestsDecided   ApprovalRequest[]       @relation("ApprovalDecidedBy")
  inchargeScopes            InchargeScope[]
  classTeacherOfSections    Section[]               @relation("SectionClassTeacher")
  teacherProfile            Teacher?
  admissionsDecided         Admission[]

  attendanceMarked            Attendance[]        @relation("AttendanceMarkedBy")
  teacherAttendanceMarked     TeacherAttendance[]  @relation("TeacherAttendanceMarkedBy")
  substitutionsCreated        Substitution[]
  curriculumProgressCompleted CurriculumProgress[]

  resultsReviewed    Result[]     @relation("ResultReviewedBy")
  resultsFinalized   Result[]     @relation("ResultFinalizedBy")
  resultsPublished   Result[]     @relation("ResultPublishedBy")
  reportCardsGenerated ReportCard[]
  promotionsDecided  Promotion[]

  paymentsRecorded          Payment[]                 @relation("PaymentRecordedBy")
  paymentsReversed          Payment[]                 @relation("PaymentReversedBy")
  paymentAdjustmentsCreated PaymentAdjustment[]
  refundsRequested          Refund[]                  @relation("RefundRequestedBy")
  refundsApproved           Refund[]                  @relation("RefundApprovedBy")
  discountsRequested        Discount[]                @relation("DiscountRequestedBy")
  discountsApproved         Discount[]                @relation("DiscountApprovedBy")
  waiversRequested          Waiver[]                  @relation("WaiverRequestedBy")
  waiversApproved           Waiver[]                  @relation("WaiverApprovedBy")
  cashClosingsClosed        CashClosing[]             @relation("CashClosingClosedBy")
  cashClosingsApproved      CashClosing[]             @relation("CashClosingApprovedBy")
  reconciliationExceptionsResolved ReconciliationException[]

  leavesRequested       Leave[]          @relation("LeaveRequestedBy")
  leavesAssigned        Leave[]          @relation("LeaveAssignedTo")
  leavesDecided         Leave[]          @relation("LeaveDecidedBy")
  admissionInquiriesCreated AdmissionInquiry[]
  complaintsSubmitted   Complaint[]      @relation("ComplaintSubmittedBy")
  complaintsAssigned    Complaint[]      @relation("ComplaintAssignedTo")
  complaintNotesAuthored ComplaintNote[]

  studentProfile Student?
  parentProfile  Parent?

  paymentAttemptsInitiated PaymentAttempt[]

  delegationsGranted   Delegation[] @relation("DelegationGrantedBy")
  delegationsReceived  Delegation[] @relation("DelegationDelegateTo")
  delegationsRevoked   Delegation[] @relation("DelegationRevokedBy")

  staffAttendances       StaffAttendance[] @relation("StaffAttendanceUser")
  staffAttendancesMarked StaffAttendance[] @relation("StaffAttendanceMarkedBy")

  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────
// Authorization: Role + Permission + Scope (spec §5)
// ─────────────────────────────────────────────────────────────────────────

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique // "resource.action", e.g. "student.edit"
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String    @id @default(uuid())
  // Phase 12 Gap 2: a free-editable DISPLAY LABEL now (an institute can
  // rename "Campus Head" to "Director") — never read by authorization
  // code anymore. Still unique so two roles can't show the same label.
  name        String    @unique
  // The stable identity authorization code keys off instead: set once by
  // the seed script for the 7 system roles (SUPER_ADMIN, CAMPUS_HEAD,
  // INCHARGE, OFFICE, TEACHER, PARENT, STUDENT) and never changed
  // afterward, regardless of what `name` becomes. Null for a custom,
  // institute-defined role — it behaves purely through its granted
  // permissions, no special-cased business logic anywhere. Never settable
  // via any public API — only prisma/seed.ts ever writes this column.
  systemKey   String?   @unique
  description String?
  isSystem    Boolean   @default(true) // the 7 core roles; system roles cannot be archived
  archivedAt  DateTime? // no-hard-delete policy — archive instead of deleting a role
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  delegations     Delegation[]

  @@map("roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  // Was a bare nullable string in Phase 0 (Campus didn't exist yet) — now a
  // real FK, per the deviation note that promised this in Phase 1.
  campusId  String?
  createdAt DateTime @default(now())
  createdBy String?

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  campus Campus? @relation(fields: [campusId], references: [id])

  @@unique([userId, roleId, campusId])
  @@index([campusId])
  @@map("user_roles")
}

// ─────────────────────────────────────────────────────────────────────────
// Sessions (spec §8 "Authentication Architecture" — httpOnly cookies + CSRF,
// refresh token rotation via this table, never store raw tokens)
// ─────────────────────────────────────────────────────────────────────────

model Session {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceInfo       String?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime
  lastUsedAt       DateTime  @default(now())
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

// ─────────────────────────────────────────────────────────────────────────
// Audit (spec §7/§8 — immutable, never edited/deleted, never holds secrets)
// ─────────────────────────────────────────────────────────────────────────

model AuditLog {
  id              String   @id @default(uuid())
  actorId         String?
  action          String // e.g. CREATE | UPDATE | APPROVE | REVERSE | VOID
  resource        String // e.g. "Result", "Payment", "UserRole"
  recordId        String?
  oldValue        Json?
  newValue        Json?
  reason          String?
  approvedBy      String?
  ipAddress       String?
  userAgent       String?
  // Phase 11 Phase A2 — set automatically (see lib/audit.ts, lib/requestContext.ts)
  // whenever the actor was acting under a currently-active Delegation at the
  // moment of this action, per the design's "non-negotiable for
  // accountability" requirement. Never set by a caller directly.
  viaDelegationId String?
  createdAt       DateTime @default(now())

  actor         User?       @relation("AuditActor", fields: [actorId], references: [id])
  viaDelegation Delegation? @relation(fields: [viaDelegationId], references: [id])

  @@index([resource, recordId])
  @@index([actorId])
  @@map("audit_logs")
}

// Phase 11 Phase A2 — a general, time-boxed grant of one role's permissions
// (scoped to one campus) to another user, e.g. covering for staff absence.
// Not a Receptionist-specific hack: usable for any role/any staff-absence
// scenario, per the user's explicit "condition based dynamically, hardcoded
// nahi" correction. Permission/scope widening is computed live at request
// time (lib/requestContext.ts + lib/delegation.ts) — no cron job needed,
// same pattern already proven for License state.
model Delegation {
  id               String    @id @default(uuid())
  grantedByUserId  String
  delegateToUserId String
  roleId           String
  campusId         String
  validFrom        DateTime
  validUntil       DateTime
  reason           String
  revokedAt        DateTime?
  revokedById      String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  grantedBy  User       @relation("DelegationGrantedBy", fields: [grantedByUserId], references: [id])
  delegateTo User       @relation("DelegationDelegateTo", fields: [delegateToUserId], references: [id])
  revokedBy  User?      @relation("DelegationRevokedBy", fields: [revokedById], references: [id])
  role       Role       @relation(fields: [roleId], references: [id])
  campus     Campus     @relation(fields: [campusId], references: [id])
  auditLogs  AuditLog[]

  @@index([delegateToUserId, validFrom, validUntil])
  @@map("delegations")
}

// ─────────────────────────────────────────────────────────────────────────
// Approval workflow (spec §5/§7 — critical actions require approval + audit)
// ─────────────────────────────────────────────────────────────────────────

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model ApprovalRequest {
  id            String         @id @default(uuid())
  type          String // e.g. "RESULT_CORRECTION", "FEE_WAIVER", "SCOPE_CHANGE"
  resource      String
  recordId      String?
  requestedById String
  approverRole  String? // role expected to decide, when not a specific user
  decidedById   String?
  status        ApprovalStatus @default(PENDING)
  payload       Json? // old/new values, reason, supporting context
  decisionNote  String?
  createdAt     DateTime       @default(now())
  decidedAt     DateTime?
  // Nullable, and deliberately unpopulated by any caller yet — schema added
  // 2026-09-12 alongside the other Phase 11A scoping columns so this
  // migration doesn't need repeating. Wiring createApprovalRequest()'s
  // callers to actually pass it, and gating decide-routes by it, is Group 6
  // of docs/PHASE_11A_CAMPUS_SCOPING_IMPLEMENTATION_PLAN.md — deliberately
  // last, since it depends on every other module's campus-derivation
  // already being correct.
  campusId      String?

  requestedBy User   @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  decidedBy   User?  @relation("ApprovalDecidedBy", fields: [decidedById], references: [id])
  campus      Campus? @relation(fields: [campusId], references: [id])

  @@index([status])
  @@map("approval_requests")
}

// ─────────────────────────────────────────────────────────────────────────
// Documents (spec §Phase 0 — universal document storage, used by Phases 2/3/6)
// ─────────────────────────────────────────────────────────────────────────

model Document {
  id           String   @id @default(uuid())
  fileName     String // random stored filename, never user-provided
  originalName String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  category     String?
  isSensitive  Boolean  @default(false)
  // Polymorphic owner link — formalized with real relations once Phase 2
  // (Student, Teacher, ...) entities exist.
  ownerType    String?
  ownerId      String?
  uploadedById String
  createdAt    DateTime @default(now())

  uploadedBy         User                @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  studentDocument    StudentDocument?
  homeworkAttachment HomeworkAttachment?

  @@index([ownerType, ownerId])
  @@map("documents")
}

// ─────────────────────────────────────────────────────────────────────────
// Notifications (spec §Phase 0 — in-app + email; SMS explicitly out of scope)
// ─────────────────────────────────────────────────────────────────────────

enum NotificationChannel {
  IN_APP
  EMAIL
}

model Notification {
  id        String              @id @default(uuid())
  userId    String
  title     String
  body      String
  channel   NotificationChannel @default(IN_APP)
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationPreference {
  id           String   @id @default(uuid())
  userId       String   @unique
  emailEnabled Boolean  @default(true)
  inAppEnabled Boolean  @default(true)
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 1 — Institute Structure
// See docs/PRODUCT_SPEC.md → "PHASE 1: CORE AUTHORIZATION & SUPER ADMIN".
//
// Campus/Class/Section assignment for Principal/Office/Teacher/etc. reuses
// Phase 0's UserRole.campusId (now a real FK, completing that deferred
// relation). A dedicated FK per role (e.g. Campus.principalId) would
// duplicate what UserRole already models — one mechanism for "who has what
// role, in what scope," not two.
// ─────────────────────────────────────────────────────────────────────────

enum InstituteType {
  SCHOOL
  ACADEMY
  COACHING_CENTER
  INSTITUTE
}

// Singleton by convention (one deployment = one institute) — enforced at the
// service layer (refuse to create a second row), not by a DB constraint,
// since Prisma/Postgres have no clean "at most one row" constraint.
model Institute {
  id        String        @id @default(uuid())
  name      String
  type      InstituteType @default(SCHOOL)
  logoUrl   String?
  address   String?
  phone     String?
  email     String?
  website   String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  settings             InstituteSettings?
  campuses             Campus[]
  classes              Class[]
  subjects             Subject[]
  terminologyOverrides TerminologyOverride[]
  featureConfigs       FeatureConfig[]

  feeCategories FeeCategory[]
  feeStructures FeeStructure[]

  @@map("institutes")
}

// Kept separate from Institute per spec's explicit "Institute Settings
// stored separately for clarity" business rule.
model InstituteSettings {
  id          String   @id @default(uuid())
  instituteId String   @unique
  timezone    String   @default("UTC")
  locale      String   @default("en")
  currency    String   @default("USD")
  updatedAt   DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@map("institute_settings")
}

// Phase 12 Gap 1 — replaces the old fixed studentLabel/teacherLabel/
// classLabel/sectionLabel columns that used to live on InstituteSettings
// (Phase 1's narrower first attempt at the same idea, per spec's "Student
// Label: Student" — found stored but functionally inert, same as
// Institute.type, when this was designed: set via the settings form,
// never actually read anywhere else). This table generalizes that to any
// entity, with a real singular/plural distinction, while institute/
// service.ts's legacy 4-field API shape stays byte-for-byte compatible for
// the existing settings form (see lib/terminology.ts).
model TerminologyOverride {
  id            String   @id @default(uuid())
  instituteId   String
  canonicalKey  String // "STUDENT" | "TEACHER" | "CLASS" | "SECTION" | "SUBJECT" | "CAMPUS" | "ENROLLMENT"
  singularLabel String
  pluralLabel   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)

  @@unique([instituteId, canonicalKey])
  @@map("terminology_overrides")
}

// Phase 12 Gap 3 — one generic table replacing a bespoke governance column
// per feature. Mirrors Google Cloud's Organization Policy hierarchy model:
// MANDATORY (institute value always wins, no campus override permitted),
// INSTITUTE_DEFAULT (a campus row overrides if present, else inherits),
// CAMPUS_CONTROLLED (institute row is only a starting suggestion; each
// campus manages its own independently). `policyMode` is only meaningful
// on the institute-level row (campusId: null) — see lib/featureConfig.ts's
// resolveFeatureConfig(), the one shared resolution function every
// feature reads through instead of duplicating this logic.
enum FeatureConfigPolicyMode {
  MANDATORY
  INSTITUTE_DEFAULT
  CAMPUS_CONTROLLED
}

model FeatureConfig {
  id          String                   @id @default(uuid())
  instituteId String
  // Null = the institute-level row (exactly one per featureKey — enforced
  // in application code, not the DB: Postgres treats NULL as distinct in a
  // unique index, so @@unique below only actually constrains campus-level
  // rows; see lib/featureConfig.ts).
  campusId    String?
  featureKey  String
  policyMode  FeatureConfigPolicyMode?
  valueJson   Json
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  institute Institute @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  campus    Campus?   @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([instituteId, campusId, featureKey])
  @@map("feature_configs")
}

model Campus {
  id          String    @id @default(uuid())
  instituteId String
  name        String
  address     String?
  phone       String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute      Institute       @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  userRoles      UserRole[]
  sections       Section[]
  inchargeScopes InchargeScope[]
  admissions     Admission[]
  cashClosings   CashClosing[]
  feeStructures  FeeStructure[]
  invoices       Invoice[]
  complaints     Complaint[]
  approvalRequests ApprovalRequest[]
  admissionInquiries AdmissionInquiry[]
  delegations        Delegation[]
  staffAttendances   StaffAttendance[]
  featureConfigs     FeatureConfig[]

  @@map("campuses")
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

// Institute-scoped, not per-campus — an institute's academic calendar is
// shared across its campuses. Deliberately allowed to overlap (spec:
// "Academic years can overlap, e.g. session-based") — no uniqueness
// constraint on date ranges.
model AcademicYear {
  id          String             @id @default(uuid())
  instituteId String
  name        String // e.g. "2026-27"
  startDate   DateTime
  endDate     DateTime
  status      AcademicYearStatus @default(ACTIVE)
  closedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  sections           Section[]
  inchargeScopes     InchargeScope[]
  admissions         Admission[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]

  timetables  Timetable[]
  curricula   Curriculum[]
  assessments Assessment[]
  exams       Exam[]
  promotions  Promotion[]

  @@unique([instituteId, name])
  @@map("academic_years")
}

// Institute-wide catalog (e.g. "Montessori", "Class 5") — configurable
// names, never hardcoded grade numbers, per spec. Campus/year-specific
// instances live on Section, not here.
model Class {
  id          String    @id @default(uuid())
  instituteId String
  name        String
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute          Institute            @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  sections           Section[]
  inchargeScopes     InchargeScopeClass[]
  admissions         Admission[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]

  curricula   Curriculum[]
  homework    Homework[]
  assessments Assessment[]
  examSchedules       ExamSchedule[]
  promotionsAsTarget  Promotion[]
  feeStructures       FeeStructure[]
  admissionInquiries  AdmissionInquiry[]

  @@unique([instituteId, name])
  @@map("classes")
}

// The actual campus+year-specific instance of a Class — this is what
// students enroll into (Phase 2) and what Incharge scopes reference.
model Section {
  id             String    @id @default(uuid())
  classId        String
  campusId       String
  academicYearId String
  name           String // configurable, not fixed A/B/C, per spec
  capacity       Int?
  classTeacherId String? // a specific responsibility, distinct from the TEACHER role itself
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  class              Class                  @relation(fields: [classId], references: [id], onDelete: Cascade)
  campus             Campus                 @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear       AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classTeacher       User?                  @relation("SectionClassTeacher", fields: [classTeacherId], references: [id])
  inchargeScopes     InchargeScopeSection[]
  enrollments        Enrollment[]
  teacherAssignments TeacherAssignment[]

  timetables          Timetable[]
  attendance          Attendance[]
  curriculumProgress  CurriculumProgress[]
  homework            Homework[]
  classDiaryEntries   ClassDiaryEntry[]
  assessments         Assessment[]
  examSchedules       ExamSchedule[]
  results             Result[]
  promotionsAsTargetSection Promotion[]

  @@unique([classId, campusId, academicYearId, name])
  @@index([campusId])
  @@map("sections")
}

// Dynamic Incharge assignment — see PRODUCT_SPEC.md §5 Authorization
// Architecture. Deliberately NOT exclusive: multiple InchargeScope rows can
// cover the same class/section (overlap is allowed by design, for workload
// sharing). `version` is for optimistic concurrency (spec: reject on
// mismatch, never silently last-write-wins).
model InchargeScope {
  id             String    @id @default(uuid())
  userId         String
  campusId       String
  academicYearId String
  effectiveFrom  DateTime  @default(now())
  effectiveTo    DateTime?
  revokedAt      DateTime?
  createdBy      String
  approvedBy     String?
  version        Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  campus       Campus                 @relation(fields: [campusId], references: [id], onDelete: Cascade)
  academicYear AcademicYear           @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  classes      InchargeScopeClass[]
  sections     InchargeScopeSection[]

  @@index([userId])
  @@map("incharge_scopes")
}

model InchargeScopeClass {
  id              String   @id @default(uuid())
  inchargeScopeId String
  classId         String
  createdAt       DateTime @default(now())

  inchargeScope InchargeScope @relation(fields: [inchargeScopeId], references: [id], onDelete: Cascade)
  class         Class         @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([inchargeScopeId, classId])
  @@map("incharge_scope_classes")
}

model InchargeScopeSection {
  id              String   @id @default(uuid())
  inchargeScopeId String
  sectionId       String
  createdAt       DateTime @default(now())

  inchargeScope InchargeScope @relation(fields: [inchargeScopeId], references: [id], onDelete: Cascade)
  section       Section       @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([inchargeScopeId, sectionId])
  @@map("incharge_scope_sections")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 2 — Academic Structure (Student/Parent/Teacher/Subject/Admission/
// Enrollment). See docs/PRODUCT_SPEC.md → "PHASE 2: ACADEMIC STRUCTURE".
//
// Student is deliberately institute/campus-context-free — its permanent
// identity (studentCode) never changes across years, campuses, or classes.
// All context (which class, section, year, roll number) lives on
// Enrollment, a separate model, per spec's core "Student ≠ Enrollment"
// rule. A student has exactly one Enrollment row per Admission, but can
// accumulate many Enrollment rows over time (promotion, transfer, re-
// admission) — never overwritten, always a new row.
// ─────────────────────────────────────────────────────────────────────────

enum StudentStatus {
  ACTIVE
  WITHDRAWN
  ARCHIVED
}

model Student {
  id          String        @id @default(uuid())
  // Permanent, human-readable identity — e.g. STU-00018427. Generated once,
  // never reused, never changes. See lib/studentCode.ts.
  studentCode String        @unique
  fullName    String
  dateOfBirth DateTime?
  gender      String?
  phone       String?
  address     String?
  // The child's own CNIC/B-Form number. Optional at the DB level,
  // deliberately — many young children in Pakistan have no B-Form yet, so
  // this must never block enrollment. A real value is treated as a strong
  // duplicate-detection signal and a valid login identifier (Phase 11
  // Phase C-addendum). @unique still allows any number of NULL rows.
  nationalId  String?       @unique
  photoUrl    String?
  status      StudentStatus @default(ACTIVE)
  withdrawnAt DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Optional login for the Student Portal (Phase 7) — most students never
  // get one (many institutes never issue student logins), so this is
  // nullable, unlike Teacher.userId which is required. onDelete: SetNull,
  // not Cascade: deleting a User must never delete the academic record it
  // was linked to. A User must already exist with the STUDENT role before
  // it can be linked here — same "link, don't create" pattern as Teacher.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  parents           StudentParent[]
  admissions        Admission[]
  enrollments       Enrollment[]
  documents         StudentDocument[]
  attendance        Attendance[]
  assessmentResults AssessmentResult[]
  results           Result[]
  promotions        Promotion[]
  studentFees       StudentFee[]
  invoices          Invoice[]
  payments          Payment[]
  creditTransactions CreditTransaction[]
  discounts         Discount[]
  leaves            Leave[]
  complaints        Complaint[]
  admissionInquiry  AdmissionInquiry?

  @@map("students")
}

model Parent {
  id        String   @id @default(uuid())
  fullName  String
  phone     String
  email     String?
  address   String?
  // The parent's own CNIC — same optionality/uniqueness reasoning as
  // Student.nationalId (Phase 11 Phase C-addendum): a strong duplicate
  // signal and a valid login identifier for a family with no email.
  nationalId String?  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Optional login for the Parent Portal (Phase 7) — same "link, don't
  // create" pattern as Student.userId above.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  children StudentParent[]

  @@map("parents")
}

// Join table — a parent can have multiple children, a child can have
// multiple parents/guardians (spec: "Parent Can Have Multiple Children —
// Link, don't duplicate").
model StudentParent {
  id           String   @id @default(uuid())
  studentId    String
  parentId     String
  relationship String? // e.g. "Father", "Mother", "Guardian"
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

enum StaffStatus {
  ACTIVE
  ARCHIVED
}

// Teaching-staff profile, 1:1 with a User that has the TEACHER role
// (created via the Phase 0 Users API). Kept separate from User because
// employment details (employee code, qualification, ...) aren't identity/
// auth concerns.
model Teacher {
  id            String      @id @default(uuid())
  userId        String      @unique
  employeeCode  String?     @unique
  qualification String?
  joiningDate   DateTime?
  phone         String?
  address       String?
  status        StaffStatus @default(ACTIVE)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  timetableEntries           TimetableEntry[]
  teacherAttendances         TeacherAttendance[]
  substitutionsAsOriginal    Substitution[]      @relation("SubstitutionOriginal")
  substitutionsAsSubstitute  Substitution[]      @relation("SubstitutionSubstitute")
  homework                   Homework[]
  classDiaryEntries          ClassDiaryEntry[]
  assessments                Assessment[]
  leaves                     Leave[]

  @@map("teachers")
}

// Institute-wide catalog, same pattern as Class (Phase 1).
model Subject {
  id          String    @id @default(uuid())
  instituteId String
  name        String
  code        String?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute   Institute           @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  assignments TeacherAssignment[]

  timetableEntries  TimetableEntry[]
  curricula         Curriculum[]
  homework          Homework[]
  classDiaryEntries ClassDiaryEntry[]
  assessments       Assessment[]
  examSchedules     ExamSchedule[]
  resultItems       ResultItem[]

  @@unique([instituteId, name])
  @@map("subjects")
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
  WITHDRAWN
}

// Admission ≠ Enrollment (spec's explicit rule): approving an Admission
// does NOT automatically create an Enrollment — that's a deliberate
// separate step (createEnrollment), matching the real workflow where fee
// assignment/other checks can happen in between.
model Admission {
  id             String          @id @default(uuid())
  studentId      String
  campusId       String
  classId        String
  academicYearId String
  status         AdmissionStatus @default(PENDING)
  appliedAt      DateTime        @default(now())
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus       Campus       @relation(fields: [campusId], references: [id])
  klass        Class        @relation(fields: [classId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  decidedBy    User?        @relation(fields: [decidedById], references: [id])

  @@index([studentId])
  @@map("admissions")
}

enum AdmissionInquiryStatus {
  NEW
  CONTACTED
  CONVERTED
  CLOSED
}

// Pre-enrollment stage (Phase 11 Phase C) — a parent who inquires but
// never commits shouldn't leave a permanent Student row behind. Nothing
// heavier than this row exists until someone deliberately converts it.
// classId is optional (a parent might not know which class/program yet);
// campusId is required — an inquiry always belongs to whichever campus
// took the call/visit.
model AdmissionInquiry {
  id              String                 @id @default(uuid())
  campusId        String
  classId         String?
  childName       String
  parentName      String
  parentPhone     String
  parentEmail     String?
  source          String?
  status          AdmissionInquiryStatus @default(NEW)
  notes           String?
  createdById     String
  convertedStudentId String?             @unique
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  campus          Campus  @relation(fields: [campusId], references: [id])
  klass           Class?  @relation(fields: [classId], references: [id])
  createdBy       User    @relation(fields: [createdById], references: [id])
  convertedStudent Student? @relation(fields: [convertedStudentId], references: [id])

  @@index([campusId, status])
  @@map("admission_inquiries")
}

enum EnrollmentStatus {
  ACTIVE
  TRANSFERRED
  WITHDRAWN
}

model Enrollment {
  id             String           @id @default(uuid())
  studentId      String
  academicYearId String
  classId        String
  sectionId      String
  rollNumber     String?
  status         EnrollmentStatus @default(ACTIVE)
  enrolledAt     DateTime         @default(now())
  withdrawnAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  klass        Class        @relation(fields: [classId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])

  promotionsFrom Promotion[] @relation("PromotionFromEnrollment")
  promotionAsNew Promotion?  @relation("PromotionNewEnrollment")

  // Roll numbers are unique within a section when assigned — NOT enforced
  // globally (spec: "Roll Number is CONTEXTUAL", repeats across sections/
  // years). "One active enrollment per academic year" is enforced at the
  // service layer, not here, because a student legitimately accumulates
  // multiple Enrollment rows per year across transfers (only one may be
  // ACTIVE at a time).
  @@unique([sectionId, rollNumber])
  @@index([studentId, academicYearId])
  @@map("enrollments")
}

// Duplicate-assignment prevention (spec: "Teacher Assignment is Academic-
// Year-Specific"). Real time-of-day scheduling conflicts are Phase 3's
// Timetable/PeriodSlot concern — this only prevents assigning the exact
// same teacher+subject+section+year combination twice.
model TeacherAssignment {
  id             String    @id @default(uuid())
  teacherId      String
  subjectId      String
  classId        String
  sectionId      String
  academicYearId String
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  teacher      Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject      Subject      @relation(fields: [subjectId], references: [id])
  klass        Class        @relation(fields: [classId], references: [id])
  section      Section      @relation(fields: [sectionId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([teacherId, subjectId, sectionId, academicYearId])
  @@index([sectionId])
  @@map("teacher_assignments")
}

// Formalizes the Student <-> Document (Phase 0) link with a real FK,
// instead of relying on Document's loose ownerType/ownerId string pair.
model StudentDocument {
  id         String   @id @default(uuid())
  studentId  String
  documentId String   @unique
  createdAt  DateTime @default(now())

  student  Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@map("student_documents")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 3 — Academic Operations (Timetable, Attendance, Substitution,
// Curriculum, Homework, Assessments). See docs/PRODUCT_SPEC.md → "PHASE 3:
// ACADEMIC OPERATIONS".
//
// Attendance/Assessment corrections reuse Phase 0's generic ApprovalRequest
// engine (type "ATTENDANCE_CORRECTION" / "ASSESSMENT_MARKS_CORRECTION")
// rather than bespoke correction tables — but the actual side effect
// (updating the Attendance row / AssessmentResult row on approval) is
// applied by dedicated decide functions in attendance/service.ts and
// assessments/service.ts, not by the generic approvals module, to avoid a
// circular dependency (approvals module would otherwise need to import
// every phase that defines a correction type).
//
// "Approved leave auto-marks attendance as Leave" (spec's Attendance
// workflow #2) is NOT implemented yet — it depends on a Leave Request
// model that doesn't exist until Phase 6 (Operations). Attendance.status
// can still be set to LEAVE manually; the auto-detection hook is deferred,
// not silently dropped. Logged in docs/PROJECT_STATUS.md.
// ─────────────────────────────────────────────────────────────────────────

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum TimetableStatus {
  DRAFT
  PUBLISHED
}

// One timetable per section per academic year. Entries are the actual
// period-by-period schedule; the timetable itself is just the draft/publish
// envelope (spec: "Publish timetable" as a distinct, audited action).
model Timetable {
  id             String          @id @default(uuid())
  sectionId      String
  academicYearId String
  status         TimetableStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  section      Section          @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  academicYear AcademicYear     @relation(fields: [academicYearId], references: [id])
  entries      TimetableEntry[]

  @@unique([sectionId, academicYearId])
  @@map("timetables")
}

// periodNumber is a simple integer slot (Period 1, 2, 3...), not a real
// clock time — schools vary too much on actual bell timings for this to be
// worth modeling precisely; startTime/endTime are optional display-only
// strings. Conflict detection (same teacher/class double-booked) is a
// service-layer check across ALL of an academic year's timetables, not a DB
// constraint, since it spans multiple Timetable rows.
model TimetableEntry {
  id           String    @id @default(uuid())
  timetableId  String
  dayOfWeek    DayOfWeek
  periodNumber Int
  subjectId    String
  teacherId    String
  startTime    String?
  endTime      String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  timetable     Timetable      @relation(fields: [timetableId], references: [id], onDelete: Cascade)
  subject       Subject        @relation(fields: [subjectId], references: [id])
  teacher       Teacher        @relation(fields: [teacherId], references: [id])
  substitutions Substitution[]

  // Same section can't have 2 subjects in the same day+period slot.
  @@unique([timetableId, dayOfWeek, periodNumber])
  @@map("timetable_entries")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

// One row per student per calendar date, regardless of which section they
// were enrolled in that day — a student only has one attendance status per
// day. Corrections go through ApprovalRequest, never a direct overwrite of
// an existing row (spec: "Corrections require approval").
model Attendance {
  id         String           @id @default(uuid())
  studentId  String
  sectionId  String
  date       DateTime
  status     AttendanceStatus
  markedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  student  Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section  Section @relation(fields: [sectionId], references: [id])
  markedBy User    @relation("AttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([studentId, date])
  @@index([sectionId, date])
  @@map("attendance")
}

// Same shape as Attendance but for teachers — kept as a separate model
// (not a polymorphic owner) since spec gives it its own permission set
// (teacher_attendance.*) and its own screen. Correction here is a direct
// permission-gated update (teacher_attendance.correct), not a full
// approval workflow — spec only details an approval-workflow diagram for
// STUDENT attendance corrections, not teacher attendance.
model TeacherAttendance {
  id         String           @id @default(uuid())
  teacherId  String
  date       DateTime
  status     AttendanceStatus
  markedById String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  teacher  Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  markedBy User    @relation("TeacherAttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([teacherId, date])
  @@map("teacher_attendance")
}

// Phase 11 Phase A3 — a different fact than TeacherAttendance's
// present/absent/leave STATUS: this is WHEN a staff member (Campus Head,
// Incharge, Teacher, or Office) physically checked in and HOW that was
// verified. User-keyed (not Teacher-keyed) since it must also cover
// Campus Head/Incharge/Office, none of whom have a Teacher record.
// Deliberately kept separate from TeacherAttendance rather than merged
// into it — merging would mean migrating an existing, working, tested
// model to a different key (Teacher -> User) for a loosely-related
// concept; auto-deriving one from the other is a real future integration,
// not done this pass (see the session log entry for what's left open).
enum StaffCheckInMethod {
  QR
  MANUAL
  REMOTE_APPROVED
}

enum StaffCheckInVerifiedStatus {
  VERIFIED
  UNVERIFIED
  MANUAL_OVERRIDE
}

model StaffAttendance {
  id             String                     @id @default(uuid())
  userId         String
  campusId       String
  date           DateTime                   @db.Date
  checkInAt      DateTime
  checkInMethod  StaffCheckInMethod
  verifiedStatus StaffCheckInVerifiedStatus
  ipAddress      String?
  geoLat         Float?
  geoLng         Float?
  markedById     String?
  createdAt      DateTime                   @default(now())

  user     User   @relation("StaffAttendanceUser", fields: [userId], references: [id])
  campus   Campus @relation(fields: [campusId], references: [id])
  markedBy User?  @relation("StaffAttendanceMarkedBy", fields: [markedById], references: [id])

  @@unique([userId, date])
  @@index([campusId, date])
  @@map("staff_attendances")
}

// Covers one specific TimetableEntry (one class period) on one date —
// "cancel" instead of delete, per the no-hard-delete policy.
model Substitution {
  id                  String    @id @default(uuid())
  timetableEntryId    String
  date                DateTime
  originalTeacherId   String
  substituteTeacherId String
  reason              String?
  createdById         String
  cancelledAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  timetableEntry    TimetableEntry @relation(fields: [timetableEntryId], references: [id], onDelete: Cascade)
  originalTeacher   Teacher        @relation("SubstitutionOriginal", fields: [originalTeacherId], references: [id])
  substituteTeacher Teacher        @relation("SubstitutionSubstitute", fields: [substituteTeacherId], references: [id])
  createdBy         User           @relation(fields: [createdById], references: [id])

  @@unique([timetableEntryId, date])
  @@map("substitutions")
}

// Curriculum = the expected syllabus (one row per topic/chapter), scoped to
// Subject+Class+AcademicYear (shared across a class's sections, since the
// syllabus itself doesn't vary by section). CurriculumProgress = the actual
// per-section teaching record against it (different sections/teachers move
// at different paces).
model Curriculum {
  id                     String    @id @default(uuid())
  subjectId              String
  classId                String
  academicYearId         String
  topic                  String
  sortOrder              Int       @default(0)
  expectedCompletionDate DateTime?
  archivedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  subject      Subject              @relation(fields: [subjectId], references: [id])
  klass        Class                @relation(fields: [classId], references: [id])
  academicYear AcademicYear         @relation(fields: [academicYearId], references: [id])
  progress     CurriculumProgress[]

  @@map("curricula")
}

model CurriculumProgress {
  id            String    @id @default(uuid())
  curriculumId  String
  sectionId     String
  completedAt   DateTime?
  completedById String?
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  curriculum  Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  section     Section    @relation(fields: [sectionId], references: [id])
  completedBy User?      @relation(fields: [completedById], references: [id])

  @@unique([curriculumId, sectionId])
  @@map("curriculum_progress")
}

enum HomeworkStatus {
  DRAFT
  PUBLISHED
}

model Homework {
  id          String         @id @default(uuid())
  subjectId   String
  sectionId   String
  classId     String
  teacherId   String
  title       String
  description String?
  dueDate     DateTime
  status      HomeworkStatus @default(DRAFT)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  subject     Subject              @relation(fields: [subjectId], references: [id])
  section     Section              @relation(fields: [sectionId], references: [id])
  klass       Class                @relation(fields: [classId], references: [id])
  teacher     Teacher              @relation(fields: [teacherId], references: [id])
  attachments HomeworkAttachment[]

  @@map("homework")
}

// Phase 11 Phase D — replaces the old single `Homework.documentId`: a
// homework post can now carry multiple files, added at creation or later
// (a Teacher realizing they forgot to attach the worksheet).
model HomeworkAttachment {
  id         String   @id @default(uuid())
  homeworkId String
  documentId String   @unique
  createdAt  DateTime @default(now())

  homework Homework @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id])

  @@index([homeworkId])
  @@map("homework_attachments")
}

// Phase 11 Phase D — a lighter-weight running log ("today we covered X"),
// distinct from formal graded/dated Homework: no attachments, no
// draft/publish lifecycle, just a fast note a Teacher can post per section
// per day. Same visibility as Homework (Parent/Student can read it) but a
// much lighter creation flow.
model ClassDiaryEntry {
  id         String    @id @default(uuid())
  sectionId  String
  subjectId  String?
  teacherId  String
  date       DateTime  @db.Date
  note       String
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  section Section  @relation(fields: [sectionId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
  teacher Teacher  @relation(fields: [teacherId], references: [id])

  @@index([sectionId, date])
  @@map("class_diary_entries")
}

enum AssessmentStatus {
  DRAFT
  SUBMITTED
}

// DRAFT → SUBMITTED is a one-way lock (spec: "After submission, editing
// requires approval"). Editing an AssessmentResult while SUBMITTED must go
// through ApprovalRequest (type "ASSESSMENT_MARKS_CORRECTION"), enforced in
// assessments/service.ts, never a bare Prisma update.
model Assessment {
  id             String           @id @default(uuid())
  subjectId      String
  sectionId      String
  classId        String
  academicYearId String
  teacherId      String
  title          String
  totalMarks     Int
  assessmentDate DateTime
  status         AssessmentStatus @default(DRAFT)
  submittedAt    DateTime?
  archivedAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  subject      Subject            @relation(fields: [subjectId], references: [id])
  section      Section            @relation(fields: [sectionId], references: [id])
  klass        Class              @relation(fields: [classId], references: [id])
  academicYear AcademicYear       @relation(fields: [academicYearId], references: [id])
  teacher      Teacher            @relation(fields: [teacherId], references: [id])
  results      AssessmentResult[]

  @@index([sectionId])
  @@index([teacherId])
  @@map("assessments")
}

model AssessmentResult {
  id            String   @id @default(uuid())
  assessmentId  String
  studentId     String
  marksObtained Float
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, studentId])
  @@map("assessment_results")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 4 — Results & Promotion (Exam, ExamSchedule, Result, ResultItem,
// ReportCard, Promotion). See docs/PRODUCT_SPEC.md → "PHASE 4: RESULTS &
// PROMOTION".
//
// Result correction reuses Phase 0's ApprovalRequest engine (type
// "RESULT_CORRECTION"), same pattern as Phase 3's attendance/assessment
// corrections — the actual ResultItem update is applied by a dedicated
// decide function in results/service.ts, not the generic approvals module.
//
// DEVIATION: ReportCard stores a JSON snapshot of the result at generation
// time, not a rendered PDF file — no PDF-generation library is chosen yet
// (same category of deferral as Phase 0's email-delivery stub). Print/
// export is a `product/web` concern (render the snapshot), not a backend
// one, once this lands.
// ─────────────────────────────────────────────────────────────────────────

enum ExamStatus {
  DRAFT
  PUBLISHED
}

// A named exam series for one academic year (e.g. "Midterm", "Final Term").
// ExamSchedule entries carry the actual per-subject/section dates.
model Exam {
  id             String     @id @default(uuid())
  academicYearId String
  name           String
  status         ExamStatus @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  academicYear AcademicYear   @relation(fields: [academicYearId], references: [id])
  schedules    ExamSchedule[]
  results      Result[]

  @@unique([academicYearId, name])
  @@map("exams")
}

// One paper: a subject, for one section, on one date/time. Conflict
// detection (a section can't sit two papers at once) is a service-layer
// overlap check across a section's schedules for the same exam, not a DB
// constraint — start/end are free-text "HH:MM" like TimetableEntry's, for
// the same reason (schools vary too much on exact timing conventions).
model ExamSchedule {
  id        String   @id @default(uuid())
  examId    String
  subjectId String
  classId   String
  sectionId String
  date      DateTime
  startTime String
  endTime   String
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  exam    Exam    @relation(fields: [examId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])
  klass   Class   @relation(fields: [classId], references: [id])
  section Section @relation(fields: [sectionId], references: [id])

  @@unique([examId, sectionId, subjectId])
  @@map("exam_schedules")
}

enum ResultStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  FINALIZED
  PUBLISHED
}

// One row per student per exam — the workflow container (spec: Draft ->
// Submitted -> Reviewed -> Finalized -> Published, sequential, never
// backward except through the correction workflow). Subject-wise marks
// live on ResultItem, not here, mirroring Result vs ResultItem in the spec.
model Result {
  id            String       @id @default(uuid())
  studentId     String
  examId        String
  sectionId     String
  status        ResultStatus @default(DRAFT)
  submittedAt   DateTime?
  reviewedById  String?
  reviewedAt    DateTime?
  finalizedById String?
  finalizedAt   DateTime?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  student    Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam       Exam        @relation(fields: [examId], references: [id])
  section    Section     @relation(fields: [sectionId], references: [id])
  reviewedBy User?       @relation("ResultReviewedBy", fields: [reviewedById], references: [id])
  finalizedBy User?      @relation("ResultFinalizedBy", fields: [finalizedById], references: [id])
  publishedBy User?      @relation("ResultPublishedBy", fields: [publishedById], references: [id])
  items      ResultItem[]
  reportCard ReportCard?

  @@unique([studentId, examId])
  @@index([sectionId])
  @@map("results")
}

// Editable only while the parent Result is DRAFT — enforced in
// results/service.ts, not here. Once FINALIZED/PUBLISHED, changes require
// the RESULT_CORRECTION approval workflow.
model ResultItem {
  id            String   @id @default(uuid())
  resultId      String
  subjectId     String
  marksObtained Float
  totalMarks    Float
  grade         String?
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  result  Result  @relation(fields: [resultId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([resultId, subjectId])
  @@map("result_items")
}

model ReportCard {
  id            String   @id @default(uuid())
  resultId      String   @unique
  snapshot      Json
  generatedById String
  generatedAt   DateTime @default(now())
  updatedAt     DateTime @updatedAt

  result      Result @relation(fields: [resultId], references: [id], onDelete: Cascade)
  generatedBy User   @relation(fields: [generatedById], references: [id])

  @@map("report_cards")
}

enum PromotionDecisionType {
  PROMOTE
  REPEAT
  PENDING
  CLASS_JUMP
}

// PROMOTE/REPEAT execute immediately (a new Enrollment is created in the
// same transaction as this row). CLASS_JUMP requires approval first —
// executedAt/newEnrollmentId stay null until decidePromotionClassJump()
// approves it. PENDING (re-exam) never executes — no new enrollment, the
// student stays as-is until a fresh decision is made later. Reuses
// enrollments/service.ts's createEnrollment() for the actual enrollment
// creation, rather than duplicating its validation.
model Promotion {
  id               String                @id @default(uuid())
  studentId        String
  fromEnrollmentId String
  academicYearId   String
  targetClassId    String
  targetSectionId  String
  decision         PromotionDecisionType
  reason           String?
  newEnrollmentId  String?               @unique
  decidedById      String
  executedAt       DateTime?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  student        Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  fromEnrollment Enrollment   @relation("PromotionFromEnrollment", fields: [fromEnrollmentId], references: [id])
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
  targetClass    Class        @relation(fields: [targetClassId], references: [id])
  targetSection  Section      @relation(fields: [targetSectionId], references: [id])
  newEnrollment  Enrollment?  @relation("PromotionNewEnrollment", fields: [newEnrollmentId], references: [id])
  decidedBy      User         @relation(fields: [decidedById], references: [id])

  @@map("promotions")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 5 — Finance Module. See docs/PRODUCT_SPEC.md → "PHASE 5: FINANCE
// MODULE". All monetary amounts use Decimal(12,2), never Float — spec's own
// worked examples (5,000 / 10,000 / partial-payment arithmetic) demand
// exact decimal math, not floating-point.
//
// CRITICAL invariant from spec: Invoice != Payment != PaymentAllocation !=
// Receipt. Four separate models, never merged, matching the spec's own
// worked example verbatim. No hard deletes anywhere in this block — void/
// reverse/cancel fields only, per spec's explicit "NEVER DELETE FINANCIAL
// RECORDS" rule.
//
// Payment reversal reuses Phase 0's ApprovalRequest engine (type
// "PAYMENT_REVERSAL"), the same "correcting an already-settled record"
// shape as Phase 3/4's corrections. Refund/Discount/Waiver/CashClosing
// instead carry their own PENDING/APPROVED/REJECTED status field with
// dedicated approve/reject routes — they are new records awaiting a first
// decision, not corrections to something already locked, matching
// Phase 2's Admission precedent rather than the correction pattern.
//
// Real payment-gateway integration (calling an actual gateway API,
// handling its callback) is explicitly Phase 9's job per the roadmap
// ("Online Payment Integration", depends on Phase 5). This phase builds
// the full data model and business rules for it (PaymentAttempt states,
// idempotency-by-gateway-txn-id, ReconciliationException safety net) plus
// a manual "simulate gateway callback" endpoint exercising that exact
// state machine — the real HTTP call to a provider is deferred, same
// category of deferral as Phase 0's email stub and Phase 4's PDF stub.
// ─────────────────────────────────────────────────────────────────────────

model FeeCategory {
  id          String    @id @default(uuid())
  instituteId String
  name        String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  institute     Institute      @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  feeStructures FeeStructure[]
  invoiceItems  InvoiceItem[]

  @@unique([instituteId, name])
  @@map("fee_categories")
}

enum FeeFrequency {
  MONTHLY
  ANNUAL
  ONE_TIME
}

// A template ("Class 5 Tuition — Monthly — 5,000") — StudentFee is the
// actual per-student assignment of one of these.
// campusId is nullable and deliberate, not an oversight: null means an
// institute-wide fee structure (visible/usable at every campus, managed by
// Office/Super Admin), a value means campus-specific (managed by that
// campus's Campus Head only) — see docs/PHASE_11A_CAMPUS_SCOPING_
// IMPLEMENTATION_PLAN.md "Gap 1". Added 2026-09-12 specifically because
// Campus Head's fee_structure.create/.edit grant (seed.ts) would otherwise
// let one campus edit every other campus's fee structures.
model FeeStructure {
  id            String       @id @default(uuid())
  instituteId   String
  campusId      String?
  classId       String
  feeCategoryId String
  name          String
  amount        Decimal      @db.Decimal(12, 2)
  frequency     FeeFrequency
  effectiveFrom DateTime
  effectiveTo   DateTime?
  archivedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  institute   Institute    @relation(fields: [instituteId], references: [id], onDelete: Cascade)
  campus      Campus?      @relation(fields: [campusId], references: [id])
  klass       Class        @relation(fields: [classId], references: [id])
  feeCategory FeeCategory  @relation(fields: [feeCategoryId], references: [id])
  studentFees StudentFee[]
  discounts   Discount[]

  @@map("fee_structures")
}

model StudentFee {
  id             String    @id @default(uuid())
  studentId      String
  feeStructureId String
  overrideAmount Decimal?  @db.Decimal(12, 2)
  effectiveFrom  DateTime  @default(now())
  archivedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student      Student      @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([studentId, feeStructureId])
  @@map("student_fees")
}

enum InvoiceStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  VOID
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  studentId     String
  // Snapshot of the student's campus (via their active Enrollment) AT THE
  // TIME this invoice was generated — deliberately not "always current
  // enrollment," so an invoice stays visible to the campus that issued it
  // even if the student later transfers campuses. Nullable only because a
  // student can theoretically have no active enrollment when invoiced
  // directly (rare, but not disallowed by the Student/Enrollment models).
  // See docs/PHASE_11A_CAMPUS_SCOPING_IMPLEMENTATION_PLAN.md.
  campusId      String?
  totalAmount   Decimal       @db.Decimal(12, 2)
  dueDate       DateTime
  status        InvoiceStatus @default(UNPAID)
  voidedAt      DateTime?
  voidReason    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  student     Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus      Campus?             @relation(fields: [campusId], references: [id])
  items       InvoiceItem[]
  allocations PaymentAllocation[]
  attempts    PaymentAttempt[]
  adjustments PaymentAdjustment[]
  waivers     Waiver[]
  creditsUsed CreditTransaction[] @relation("CreditUsedOnInvoice")

  @@index([studentId])
  @@index([campusId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id            String   @id @default(uuid())
  invoiceId     String
  feeCategoryId String
  description   String
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  feeCategory FeeCategory @relation(fields: [feeCategoryId], references: [id])

  @@map("invoice_items")
}

enum PaymentMethod {
  CASH
  ONLINE
}

enum PaymentStatus {
  SUCCESS
  REVERSED
}

model Payment {
  id               String        @id @default(uuid())
  paymentNumber    String        @unique
  studentId        String
  amount           Decimal       @db.Decimal(12, 2)
  method           PaymentMethod
  status           PaymentStatus @default(SUCCESS)
  paymentAttemptId String?       @unique
  recordedById     String
  reversedById     String?
  reversedAt       DateTime?
  reversalReason   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  recordedBy     User                @relation("PaymentRecordedBy", fields: [recordedById], references: [id])
  reversedBy     User?               @relation("PaymentReversedBy", fields: [reversedById], references: [id])
  paymentAttempt PaymentAttempt?     @relation(fields: [paymentAttemptId], references: [id])
  allocations    PaymentAllocation[]
  receipt        Receipt?
  refunds        Refund[]
  creditsSourced CreditTransaction[] @relation("CreditSourcePayment")

  @@index([studentId])
  @@map("payments")
}

enum AllocationStatus {
  ACTIVE
  REVERSED
}

// Links a Payment to an Invoice — the mechanism that makes partial and
// multi-invoice payments possible (spec rule #5) without conflating
// Payment and Invoice into one record.
model PaymentAllocation {
  id               String            @id @default(uuid())
  allocationNumber String            @unique
  paymentId        String
  invoiceId        String
  amount           Decimal           @db.Decimal(12, 2)
  status           AllocationStatus  @default(ACTIVE)
  createdAt        DateTime          @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
  @@index([paymentId])
  @@map("payment_allocations")
}

enum PaymentAttemptStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

// Tracks an online payment attempt independently of Payment — a gateway
// call can fail/retry without ever producing a Payment row. gatewayTxnId
// is the idempotency key preventing a duplicate Payment from a replayed
// webhook (spec rule #9).
model PaymentAttempt {
  id            String                @id @default(uuid())
  attemptNumber String                @unique
  invoiceId     String
  amount        Decimal               @db.Decimal(12, 2)
  status        PaymentAttemptStatus  @default(INITIATED)
  gatewayTxnId  String?               @unique
  failureReason String?
  // Who initiated this attempt — set by Phase 9's online-payment flow
  // (the paying Parent/Student's own user id, since the eventual
  // Payment.recordedById needs a real User and a webhook callback has no
  // session of its own to draw one from). Null for Phase 5's
  // staff-initiated manual attempts, which already have an actorId at
  // the call site for their own audit log.
  initiatedById String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  invoice Invoice  @relation(fields: [invoiceId], references: [id])
  initiatedBy User? @relation(fields: [initiatedById], references: [id])
  payment Payment?
  gatewayTransaction GatewayTransaction?

  @@map("payment_attempts")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 9 — Online Payment Integration. See docs/PRODUCT_SPEC.md →
// "PHASE 9: ONLINE PAYMENT INTEGRATION".
//
// No real gateway account exists (Easypaisa/JazzCash aren't things a dev
// session can sign up for) — SIMULATED is the only provider actually
// wired up, using the exact same webhook contract (HMAC-signed callback,
// idempotency by gatewayTxnId, amount verification) a real integration
// would use, so swapping in a real provider later is a config change,
// not an architecture change. Same category of honest stub as Phase 0's
// email delivery and Phase 4's report-card PDF.
// ─────────────────────────────────────────────────────────────────────────

enum PaymentGatewayProvider {
  EASYPAISA
  JAZZCASH
  SIMULATED
}

model PaymentGateway {
  id            String                 @id @default(uuid())
  provider      PaymentGatewayProvider
  name          String
  isActive      Boolean                @default(true)
  // HMAC-SHA256 secret used to sign/verify webhook callbacks — generated
  // server-side (lib/tokens.ts), never a real provider credential.
  webhookSecret String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  transactions GatewayTransaction[]

  @@map("payment_gateways")
}

enum GatewayTransactionStatus {
  INITIATED
  PENDING
  SUCCESS
  FAILED
}

// The gateway-side record of one payment attempt — distinct from
// PaymentAttempt (our own "intent to pay" row, Phase 5) per spec's
// explicit 5-model list. One PaymentAttempt has at most one
// GatewayTransaction (the attempt might never reach the gateway at all,
// e.g. the parent abandons the checkout page).
model GatewayTransaction {
  id           String                    @id @default(uuid())
  gatewayId    String
  attemptId    String                    @unique
  // Assigned once the (simulated) gateway "processes" the checkout —
  // null while still INITIATED, exactly like a real gateway wouldn't
  // hand back a transaction id until the payer completes the hosted
  // checkout flow.
  gatewayTxnId String?                   @unique
  amount       Decimal                   @db.Decimal(12, 2)
  status       GatewayTransactionStatus  @default(INITIATED)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt

  gateway   PaymentGateway  @relation(fields: [gatewayId], references: [id])
  attempt   PaymentAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  callbacks PaymentCallback[]

  @@map("gateway_transactions")
}

// One row per webhook HTTP call received, regardless of outcome —
// including invalid-signature and unmatched-transaction calls, which
// never touch GatewayTransaction/Payment at all. This is the audit trail
// spec's "All actions AUDITED" reconciliation-safety rule asks for, and
// what makes "Duplicate callback -> no duplicate payment" and "Invalid
// callback signature -> rejected" independently verifiable after the
// fact, not just inferable from side effects.
model PaymentCallback {
  id                   String   @id @default(uuid())
  gatewayTransactionId String?
  gatewayTxnId         String
  signatureValid       Boolean
  rawBody              Json
  outcome              String
  createdAt            DateTime @default(now())

  gatewayTransaction GatewayTransaction? @relation(fields: [gatewayTransactionId], references: [id])

  @@map("payment_callbacks")
}

enum CreditStatus {
  AVAILABLE
  USED
}

// Overpayment handling (spec rule #6) — never refunded automatically,
// held as a credit balance a future invoice can draw down.
model CreditTransaction {
  id                String       @id @default(uuid())
  transactionNumber String       @unique
  studentId         String
  amount            Decimal      @db.Decimal(12, 2)
  sourcePaymentId   String
  status            CreditStatus @default(AVAILABLE)
  usedOnInvoiceId   String?
  usedAt            DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  student       Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  sourcePayment Payment  @relation("CreditSourcePayment", fields: [sourcePaymentId], references: [id])
  usedOnInvoice Invoice? @relation("CreditUsedOnInvoice", fields: [usedOnInvoiceId], references: [id])

  @@map("credit_transactions")
}

enum ReceiptStatus {
  ACTIVE
  CANCELLED
}

model Receipt {
  id            String        @id @default(uuid())
  receiptNumber String        @unique
  paymentId     String        @unique
  status        ReceiptStatus @default(ACTIVE)
  generatedAt   DateTime      @default(now())
  cancelledAt   DateTime?

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("receipts")
}

// Generic correction to an invoice's effective total (spec: "corrections/
// adjustments") — always audited, always additive history, never an
// in-place edit of Invoice.totalAmount itself.
model PaymentAdjustment {
  id          String   @id @default(uuid())
  invoiceId   String
  amount      Decimal  @db.Decimal(12, 2)
  reason      String
  createdById String
  createdAt   DateTime @default(now())

  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id])

  @@map("payment_adjustments")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Refund {
  id            String       @id @default(uuid())
  refundNumber  String       @unique
  paymentId     String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  method        String?
  status        RefundStatus @default(PENDING)
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  completedAt   DateTime?
  // Set when completing a refund whose original Payment came through an
  // online gateway (Phase 9 spec test #10, "Refund through gateway ->
  // processed correctly") — the (simulated) gateway's own reference for
  // the reversing transaction. Null for a cash refund.
  gatewayRefundReference String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  payment     Payment @relation(fields: [paymentId], references: [id])
  requestedBy User    @relation("RefundRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("RefundApprovedBy", fields: [approvedById], references: [id])

  @@map("refunds")
}

enum DiscountType {
  SIBLING
  MERIT
  STAFF
  OTHER
}

enum DiscountStatus {
  PENDING
  APPROVED
  REJECTED
}

// Exactly one of amount/percentage is set — validated in
// discounts/service.ts, not expressible as a DB constraint.
model Discount {
  id             String         @id @default(uuid())
  studentId      String
  feeStructureId String?
  type           DiscountType
  amount         Decimal?       @db.Decimal(12, 2)
  percentage     Decimal?       @db.Decimal(5, 2)
  reason         String
  status         DiscountStatus @default(PENDING)
  requestedById  String
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructure FeeStructure? @relation(fields: [feeStructureId], references: [id])
  requestedBy  User          @relation("DiscountRequestedBy", fields: [requestedById], references: [id])
  approvedBy   User?         @relation("DiscountApprovedBy", fields: [approvedById], references: [id])

  @@map("discounts")
}

enum WaiverStatus {
  PENDING
  APPROVED
  REJECTED
}

model Waiver {
  id            String       @id @default(uuid())
  invoiceId     String
  amount        Decimal      @db.Decimal(12, 2)
  reason        String
  status        WaiverStatus @default(PENDING)
  requestedById String
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  requestedBy User    @relation("WaiverRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User?   @relation("WaiverApprovedBy", fields: [approvedById], references: [id])

  @@map("waivers")
}

enum CashClosingStatus {
  PENDING
  APPROVED
}

model CashClosing {
  id              String            @id @default(uuid())
  campusId        String
  date            DateTime
  openingBalance  Decimal           @db.Decimal(12, 2)
  collections     Decimal           @db.Decimal(12, 2)
  refundsPaidOut  Decimal           @db.Decimal(12, 2) @default(0)
  expectedBalance Decimal           @db.Decimal(12, 2)
  actualBalance   Decimal           @db.Decimal(12, 2)
  variance        Decimal           @db.Decimal(12, 2)
  status          CashClosingStatus @default(PENDING)
  closedById      String
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  campus     Campus @relation(fields: [campusId], references: [id])
  closedBy   User   @relation("CashClosingClosedBy", fields: [closedById], references: [id])
  approvedBy User?  @relation("CashClosingApprovedBy", fields: [approvedById], references: [id])

  @@unique([campusId, date])
  @@map("cash_closings")
}

enum ReconciliationStatus {
  PENDING
  RESOLVED
  REJECTED
}

// Spec's "Reconciliation Safety Rule": an incoming gateway transaction with
// no matching PaymentAttempt NEVER auto-creates a Payment — it lands here
// for manual review instead.
model ReconciliationException {
  id             String               @id @default(uuid())
  gatewayTxnId   String
  amount         Decimal              @db.Decimal(12, 2)
  rawData        Json
  status         ReconciliationStatus @default(PENDING)
  resolvedById   String?
  resolvedAt     DateTime?
  resolutionNote String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  resolvedBy User? @relation(fields: [resolvedById], references: [id])

  @@map("reconciliation_exceptions")
}

// ─────────────────────────────────────────────────────────────────────────
// Phase 6 — Operations (Leave, Complaint, ComplaintNote). See
// docs/PRODUCT_SPEC.md → "PHASE 6: OPERATIONS". Document and Notification
// (Phase 0) are reused here, not re-modeled — complaint attachments use
// Document's existing polymorphic ownerType/ownerId ("Complaint", id),
// same mechanism Phase 2 used before StudentDocument formalized a real FK
// for the higher-volume student-document case; complaint volume doesn't
// warrant a dedicated join table the same way.
//
// This phase also completes a deferral Phase 3 explicitly logged: "Approved
// leave auto-marks attendance as Leave" (spec's Attendance workflow #2) —
// implemented in attendance/service.ts's markAttendance, which now checks
// Leave via a function this module exports, overriding an ABSENT mark to
// LEAVE when an APPROVED student leave covers that date.
// ─────────────────────────────────────────────────────────────────────────

enum LeaveSubjectType {
  STUDENT
  TEACHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// Exactly one of studentId/teacherId is set — validated in
// leaves/service.ts, not expressible as a DB constraint.
model Leave {
  id             String           @id @default(uuid())
  subjectType    LeaveSubjectType
  studentId      String?
  teacherId      String?
  fromDate       DateTime
  toDate         DateTime
  reason         String
  isRetrospective Boolean         @default(false)
  status         LeaveStatus      @default(PENDING)
  requestedById  String
  // Who's currently responsible for deciding this — auto-resolved to the
  // student's section Incharge at creation (Phase 11 Phase B), forwardable
  // to that section's Class Teacher. Nullable: falls back to null (Office/
  // Campus Head handle it directly) when no Incharge can be resolved, e.g.
  // a student with no active enrollment yet, or a TEACHER-subject leave.
  // Mirrors Complaint.assignedToId, added later for the same reason.
  assignedToId   String?
  decidedById    String?
  decidedAt      DateTime?
  decisionNote   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student     Student? @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher     Teacher? @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  requestedBy User     @relation("LeaveRequestedBy", fields: [requestedById], references: [id])
  assignedTo  User?    @relation("LeaveAssignedTo", fields: [assignedToId], references: [id])
  decidedBy   User?    @relation("LeaveDecidedBy", fields: [decidedById], references: [id])

  @@index([studentId, fromDate, toDate])
  @@index([teacherId])
  @@map("leaves")
}

enum ComplaintStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
  REOPENED
}

// Status lifecycle per spec: OPEN -> ASSIGNED -> IN_PROGRESS -> RESOLVED ->
// CLOSED -> REOPENED (-> ASSIGNED again, fresh investigation) — enforced
// sequentially in complaints/service.ts, same assertTransition shape as
// Phase 4's Result workflow. "Cannot close without resolution" means CLOSED
// is only reachable from RESOLVED, never any other status.
model Complaint {
  id             String          @id @default(uuid())
  studentId      String?
  // Required, unlike studentId — a complaint not about any specific student
  // (e.g. a general facility complaint) still needs a campus home for
  // scoping to work; the service layer derives it from the student's active
  // enrollment when studentId is given, or requires it explicitly
  // otherwise. See docs/PHASE_11A_CAMPUS_SCOPING_IMPLEMENTATION_PLAN.md
  // "Gap 2" — added 2026-09-12, this model previously had no campus anchor
  // at all when studentId was null.
  campusId       String
  category       String
  description    String
  status         ComplaintStatus @default(OPEN)
  submittedById  String
  assignedToId   String?
  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  student     Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  campus      Campus          @relation(fields: [campusId], references: [id])
  submittedBy User            @relation("ComplaintSubmittedBy", fields: [submittedById], references: [id])
  assignedTo  User?           @relation("ComplaintAssignedTo", fields: [assignedToId], references: [id])
  notes       ComplaintNote[]

  @@index([campusId])
  @@index([studentId])
  @@map("complaints")
}

model ComplaintNote {
  id          String   @id @default(uuid())
  complaintId String
  authorId    String
  note        String
  createdAt   DateTime @default(now())

  complaint Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id])

  @@map("complaint_notes")
}
